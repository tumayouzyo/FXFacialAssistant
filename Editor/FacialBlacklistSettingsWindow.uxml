<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="FacialBlacklistSettingsWindow.uss" />
  <ui:VisualElement class="blacklist-settings">
    <ui:Label text="記録対象のブラックリスト" class="settings-heading" />
    <ui:Label text="表示の切り替えと再適用は、メインウィンドウのメッシュ一覧上にある「非表示」「ブラックリスト適用」から行えます。" class="settings-description" />
    <ui:Label text="1行に1ルール。大文字・小文字は区別しません。* は任意の文字列、? は任意の1文字に一致します。空行と # で始まる行は無視します。" class="settings-description" />
    <ui:Label text="例：vrc.* は前方一致、eyeBlinkLeft は名前全体との一致です。" class="settings-description" />
    <ui:ScrollView class="rules-scroll">
      <ui:TextField name="rulesText" multiline="true" class="rules-editor" />
    </ui:ScrollView>
    <ui:Label name="matchSummary" class="settings-description" />
    <ui:Label text="適用すると、現在のメッシュで一致する項目もオフになります。ルールから外した項目のチェックは維持します。全体を初期化するにはアバターを再読み込みしてください。設定はこのプロジェクト用として保存します。" class="settings-description" />
    <ui:VisualElement class="settings-actions">
      <ui:Button name="defaultsButton" text="初期ルールに戻す" />
      <ui:VisualElement class="settings-spacer" />
      <ui:Button name="cancelButton" text="キャンセル" />
      <ui:Button name="applyButton" text="適用して閉じる" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
