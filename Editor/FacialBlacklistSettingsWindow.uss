.blacklist-settings { flex-grow: 1; padding: 10px; }
.settings-heading { -unity-font-style: bold; margin-bottom: 8px; }
.settings-description { white-space: normal; margin-top: 5px; margin-bottom: 5px; flex-shrink: 0; }
.rules-scroll { flex-grow: 1; flex-basis: 0; min-height: 160px; margin-top: 5px; margin-bottom: 5px; }
.rules-editor { flex-shrink: 0; min-height: 160px; }
.settings-actions { flex-direction: row; flex-shrink: 0; margin-top: 7px; }
.settings-spacer { flex-grow: 1; }
